# Base URL for the API. Leave empty (default) to use the Vite dev proxy,
# which forwards /api to VITE_API_PROXY_TARGET (default http://localhost:5000).
# In production behind nginx the app and API share an origin — keep it empty.
VITE_API_BASE_URL=

# Dev proxy target used by `npm run dev` (not used in production builds).
VITE_API_PROXY_TARGET=http://localhost:5000
