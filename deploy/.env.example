# PostgreSQL superuser password (docker-compose)
POSTGRES_PASSWORD=change-me-strong

# JWT signing key (min 32 chars)
AUTH__JWT__SIGNING_KEY=change-me-0123456789-0123456789-0123456789

# Telegram notifications (optional — disabled until Enabled=true + BotToken set)
TELEGRAM__ENABLED=false
TELEGRAM__BOT_TOKEN=
TELEGRAM__BOT_USERNAME=
TELEGRAM__WEBHOOK_SECRET=

# Promote this phone number to Admin after their first login (optional)
ADMIN_BOOTSTRAP__PHONE_NUMBER=
